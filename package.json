{
  "name": "mymeetings",
  "version": "0.0.1",
  "description": "Modular Monolith with DDD — NestJS port of kgrzybek/modular-monolith-with-ddd",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build api",
    "format": "prettier --write \"apps/**/*.ts\" \"src/**/*.ts\"",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/apps/api/apps/api/src/main.js",
    "lint": "eslint \"{apps,src}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json",
    "migrate": "tsx database/migrate.ts",
    "seed": "tsx database/seed.ts",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps src || true"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.1.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.14.1",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dependency-cruiser": "^16.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/src/"
    ],
    "moduleNameMapper": {
      "^@building-blocks/domain(.*)$": "<rootDir>/src/building-blocks/domain/src$1",
      "^@building-blocks/application(.*)$": "<rootDir>/src/building-blocks/application/src$1",
      "^@building-blocks/infrastructure(.*)$": "<rootDir>/src/building-blocks/infrastructure/src$1",
      "^@modules/user-access(.*)$": "<rootDir>/src/modules/user-access/src$1",
      "^@modules/registrations(.*)$": "<rootDir>/src/modules/registrations/src$1",
      "^@modules/administration(.*)$": "<rootDir>/src/modules/administration/src$1",
      "^@modules/meetings(.*)$": "<rootDir>/src/modules/meetings/src$1",
      "^@modules/payments(.*)$": "<rootDir>/src/modules/payments/src$1"
    }
  }
}