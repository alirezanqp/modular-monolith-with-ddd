{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "building-blocks-domain": {
      "type": "library",
      "root": "src/building-blocks/domain",
      "entryFile": "index",
      "sourceRoot": "src/building-blocks/domain/src",
      "compilerOptions": {
        "tsConfigPath": "src/building-blocks/domain/tsconfig.lib.json"
      }
    },
    "building-blocks-application": {
      "type": "library",
      "root": "src/building-blocks/application",
      "entryFile": "index",
      "sourceRoot": "src/building-blocks/application/src",
      "compilerOptions": {
        "tsConfigPath": "src/building-blocks/application/tsconfig.lib.json"
      }
    },
    "building-blocks-infrastructure": {
      "type": "library",
      "root": "src/building-blocks/infrastructure",
      "entryFile": "index",
      "sourceRoot": "src/building-blocks/infrastructure/src",
      "compilerOptions": {
        "tsConfigPath": "src/building-blocks/infrastructure/tsconfig.lib.json"
      }
    },
    "user-access": {
      "type": "library",
      "root": "src/modules/user-access",
      "entryFile": "index",
      "sourceRoot": "src/modules/user-access/src",
      "compilerOptions": {
        "tsConfigPath": "src/modules/user-access/tsconfig.lib.json"
      }
    },
    "registrations": {
      "type": "library",
      "root": "src/modules/registrations",
      "entryFile": "index",
      "sourceRoot": "src/modules/registrations/src",
      "compilerOptions": {
        "tsConfigPath": "src/modules/registrations/tsconfig.lib.json"
      }
    },
    "administration": {
      "type": "library",
      "root": "src/modules/administration",
      "entryFile": "index",
      "sourceRoot": "src/modules/administration/src",
      "compilerOptions": {
        "tsConfigPath": "src/modules/administration/tsconfig.lib.json"
      }
    },
    "meetings": {
      "type": "library",
      "root": "src/modules/meetings",
      "entryFile": "index",
      "sourceRoot": "src/modules/meetings/src",
      "compilerOptions": {
        "tsConfigPath": "src/modules/meetings/tsconfig.lib.json"
      }
    },
    "payments": {
      "type": "library",
      "root": "src/modules/payments",
      "entryFile": "index",
      "sourceRoot": "src/modules/payments/src",
      "compilerOptions": {
        "tsConfigPath": "src/modules/payments/tsconfig.lib.json"
      }
    }
  }
}
